# ============ AB-new Bot Settings ============
# MODE: paper = تداول ورقي (افتراضي - بدون أموال حقيقية)
#       live  = تداول حقيقي (يتطلب مفتاح المحفظة)
AB_MODE=paper

# --- Paper mode settings (الوضع الورقي) ---
AB_PAPER_SOL=1          # رصيد SOL الافتراضي للتجربة
AB_PAPER_FEE_PCT=1      # نسبة العمولة المحاكاة %
AB_PAPER_STATS_MS=30000 # كل كم ثانية تُعرض الإحصائيات

# --- Live mode (التداول الحقيقي) ---
AB_PRIVATE_KEY=
AB_RPC_URL=https://api.mainnet-beta.solana.com

# --- Strategy (تشترك في الوضعين) ---
AB_SNIPE=true
AB_COPY_WALLETS=
AB_BUY_SOL=0.01
AB_SLIPPAGE=10
AB_PRIORITY_FEE=0.00005
AB_MAX_POSITIONS=3
AB_STOP_LOSS=30
AB_TAKE_PROFIT=50
AB_HOLD_TIMEOUT_MS=600000
